{
  "name": "enku-partners",
  "version": "1.0.0",
  "description": "Enku Partners Affiliate Network Platform on Cloudflare Pages & D1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/styles.css --minify && tsc --noEmit",
    "css:build": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/styles.css --minify",
    "css:watch": "tailwindcss -i ./src/styles/input.css -o ./public/static/css/styles.css --watch",
    "deploy": "npm run css:build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply enku-partners-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply enku-partners-db --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "@tailwindcss/cli": "^4.0.9",
    "@types/node": "^26.6.5",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.5",
    "wrangler": "^3.90.0"
  }
}
